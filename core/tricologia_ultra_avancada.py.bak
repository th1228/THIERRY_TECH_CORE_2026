        elementos_bloco_pagina1.append(tab_nutra)
        elementos_bloco_pagina1.append(Spacer(1, 1))

        # --- TABELA 05: ENGENHARIA DE PRECIFICAÇÃO E ALOCAÇÃO APEX ---
