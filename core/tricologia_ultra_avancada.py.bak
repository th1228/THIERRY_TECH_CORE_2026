                Paragraph(item['status'], estilo_corpo),
                Paragraph(f"<b><font color='#00875A'>{item['investimento']}</font></b>", estilo_metrica_verde)
            ])
        tab_medo = Table(tabela_medo_data, colWidths=[45, 75, 235, 145])
        tab_medo.setStyle(TableStyle([
