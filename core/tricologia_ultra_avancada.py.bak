            ('ROWBACKGROUNDS', (0,0), (-1,-1), [TABLE_HEADER_BG, WHITE_BG]),
            ('BOX', (0,0), (-1,-1), 0.5, CARD_BORDER),
            ('INNERGRID', (0,0), (-1,-1), 0.3, CARD_BORDER),
