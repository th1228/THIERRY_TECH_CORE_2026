                <button class="lang-btn" onclick="gerarPdfComHistorico()" style="font-size: 10px; padding: 7px 12px; display: flex; align-items: center; gap: 4px; border-color: var(--accent-clinical); color: var(--accent-clinical);">
                    📄 <span id="uhnw-btn-pdf-text">Gerar Relatório PDF</span>
