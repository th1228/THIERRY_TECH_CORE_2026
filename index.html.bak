        async function salvarEAtivarApexProtocol() {
            const ceoName = document.getElementById('modal-ceo-name').value;
            const companyName = document.getElementById('modal-company-name').value;
            document.getElementById('client-name-input').value = ceoName;
            document.getElementById('client-company-input').value = companyName;
            updateHeaderCompany(companyName);
            salvarEstadoNoNavegador();
            closeApexCredentialsModal();
            document.getElementById('biometric-consent-checkbox').checked = true;
            verificarConsentimentoBiometrico();
        }

        function verificarConsentimentoBiometrico() {
            consentimentoBiometricoAtivo = document.getElementById('biometric-consent-checkbox').checked;
            if (consentimentoBiometricoAtivo) {
                cameraActive = true;
                document.getElementById('btn-toggle-camera').innerText = "CAM: LIGADA";
                inicializarWebcamSoberana();
            } else {
                cameraActive = false;
                document.getElementById('btn-toggle-camera').innerText = "CAM: BLOQUEADA";
                if (mediaStreamObj) { mediaStreamObj.getTracks().forEach(track => track.stop()); }
            }
        }

        function inicializarWebcamSoberana() {
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720, facingMode: 'user' }, audio: false })
                    .then(stream => { mediaStreamObj = stream; video.srcObject = stream; video.play().catch(e => {}); requestAnimationFrame(renderMeshOverlay); })
                    .catch(e => console.error(e));
            }
        }

        async function dispararVarreduraComGateway(ecosystemTipo) {
            if (!consentimentoBiometricoAtivo) { alert("⚠️ Aceite o termo biométrico ou o Apex Protocol primeiro!"); return; }
            selectArchetypeProfile(ecosystemTipo);
            startCinematicScan();
        }

