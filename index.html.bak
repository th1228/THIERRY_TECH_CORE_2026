        function abrirComandoDeVozModal() { 
            document.getElementById('voice-command-modal').classList.add('active-modal');
            iniciarReconhecimentoVozReal();
        }

        function fecharComandoDeVozModal() { 
            document.getElementById('voice-command-modal').classList.remove('active-modal');
            if (recognitionObj) {
                try { recognitionObj.stop(); } catch(e) {}
            }
        }

        function iniciarReconhecimentoVozReal() {
            const outputEl = document.getElementById('voice-transcription-output');
            const statusEl = document.getElementById('voice-live-status');

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                outputEl.innerHTML = "⚠️ Seu navegador não suporta reconhecimento de voz nativo. Use o botão de simulação abaixo.";
                statusEl.innerText = "[MODO SIMULAÇÃO ATIVO]";
                return;
            }

            try {
                recognitionObj = new SpeechRecognition();
                recognitionObj.lang = currentLang === 'PT' ? 'pt-BR' : 'en-US';
                recognitionObj.continuous = true;
                recognitionObj.interimResults = true;

                recognitionObj.onstart = () => {
                    statusEl.innerText = "[OUVINDO COMANDOS CLÍNICOS EM TEMPO REAL]";
                };

                recognitionObj.onresult = (event) => {
                    let interimTranscript = '';
                    let finalTranscript = '';

                    for (let i = event.resultIndex; i < event.results.length; ++i) {
                        if (event.results[i].isFinal) {
                            finalTranscript += event.results[i][0].transcript;
                        } else {
                            interimTranscript += event.results[i][0].transcript;
                        }
                    }

                    if (finalTranscript) {
                        const capitalizedText = finalTranscript.charAt(0).toUpperCase() + finalTranscript.slice(1);
                        outputEl.innerHTML += `<br><b style="color:var(--accent-clinical);">[VOZ MÉDICA]:</b> ${capitalizedText}`;
                        outputEl.scrollTop = outputEl.scrollHeight;
                        logKernelMessage(`[VOICE RECOGNITION] "${capitalizedText}"`);
                        
                        const comando = finalTranscript.toLowerCase();
                        if (comando.includes('varredura') || comando.includes('scan') || comando.includes('executar')) {
                            fecharComandoDeVozModal();
                            startCinematicScan();
                        } else if (comando.includes('liderança') || comando.includes('leadership')) {
                            selectArchetypeProfile('lideranca');
                        } else if (comando.includes('relatório') || comando.includes('pdf')) {
                            openPdfModal();
                        }
                    } else if (interimTranscript) {
                        const baseText = outputEl.innerHTML.split('<span style="color:var(--text-secondary);">')[0];
                        outputEl.innerHTML = baseText + `<span style="color:var(--text-secondary);">[Ouvindo: ${interimTranscript}]</span>`;
                        outputEl.scrollTop = outputEl.scrollHeight;
                    }
                };

                recognitionObj.onerror = (event) => {
                    statusEl.innerText = "[ERRO NO MICROFONE / TENTE NOVAMENTE]";
                };

                recognitionObj.onend = () => {
                    statusEl.innerText = "[ESCUTA PAUSADA / CLIQUE EM REINICIAR]";
                };

                recognitionObj.start();
            } catch(e) {
                console.error(e);
            }
        }

        function reiniciarEscutaVoz() {
            if (recognitionObj) {
                try { recognitionObj.stop(); } catch(e) {}
            }
            document.getElementById('voice-transcription-output').innerHTML = "[VOZ SOBERANA]: Escuta reiniciada. Fale sua conduta clínica...";
            iniciarReconhecimentoVozReal();
        }

        function simularDisparoVoz() {
            fecharComandoDeVozModal();
            logKernelMessage('[VOICE] Comando vocal clínico simulado executado.');
            startCinematicScan();
        }

