            animation: reportPulseButton 2.5s infinite; 
        }

        /* Estilo Sofisticado dos Modais UHNW */
        .uhnw-modal-overlay {
            position: fixed; inset: 0; background: rgba(3, 5, 8, 0.88); backdrop-filter: blur(15px);
            z-index: 99999; display: none; justify-content: center; align-items: center; padding: 20px;
