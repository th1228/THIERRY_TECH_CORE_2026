        function typeWriterLog(fullText, speed = 12) {
            const term = document.getElementById('terminal-logs');
            if(!term) return;
            const timeStr = new Date().toLocaleTimeString();
            const linePrefix = `<br>[${timeStr}] `;
            term.innerHTML += linePrefix;
            let i = 0;
            function typeChar() {
                if (i < fullText.length) {
                    term.innerHTML += fullText.charAt(i);
                    i++;
                    term.scrollTop = term.scrollHeight;
                    setTimeout(typeChar, speed);
                }
            }
            typeChar();
        }

        function logKernelMessage(msg) { typeWriterLog(msg); }

        function salvarEstadoNoNavegador() {
            const checkboxes = document.querySelectorAll('#geo-countries-scroll-container input[type="checkbox"]');
            const geoEstado = Array.from(checkboxes).map(cb => cb.checked);
            const dadosSalvos = {
                ceoName: document.getElementById('modal-ceo-name').value,
                companyName: document.getElementById('modal-company-name').value,
                marketSegment: document.getElementById('modal-market-segment').value,
                horizonYears: document.getElementById('modal-horizon-years').value,
                emailInput: document.getElementById('modal-email-input').value,
                geoStates: geoEstado
            };
            localStorage.setItem('tcc_sovereign_terminal_state', JSON.stringify(dadosSalvos));
        }

        function carregarEstadoDoNavegador() {
            const salvo = localStorage.getItem('tcc_sovereign_terminal_state');
            if (!salvo) return;
            try {
                const dados = JSON.parse(salvo);
                if(dados.ceoName) { document.getElementById('modal-ceo-name').value = dados.ceoName; document.getElementById('client-name-input').value = dados.ceoName; }
                if(dados.companyName) { document.getElementById('modal-company-name').value = dados.companyName; document.getElementById('client-company-input').value = dados.companyName; updateHeaderCompany(dados.companyName); }
                if(dados.marketSegment) document.getElementById('modal-market-segment').value = dados.marketSegment;
                if(dados.horizonYears) document.getElementById('modal-horizon-years').value = dados.horizonYears;
                if(dados.emailInput) { document.getElementById('modal-email-input').value = dados.emailInput; document.getElementById('client-email-input').value = dados.emailInput; document.getElementById('dispatch-email-target').value = dados.emailInput; }
            } catch(e) { console.error(e); }
        }

        window.addEventListener('DOMContentLoaded', () => { 
            carregarEstadoDoNavegador(); 
            initInteractive3DConfrontationCards();
        });

        function changeSystemLanguage(lang) {
            currentLang = lang;
            document.getElementById('btn-pt').classList.toggle('active-lang', lang === 'PT');
            document.getElementById('btn-en').classList.toggle('active-lang', lang === 'EN');
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang][key]) { el.innerText = translations[lang][key]; }
            });
            if (!consentimentoBiometricoAtivo) { document.getElementById('btn-toggle-camera').innerText = translations[lang].camBtn; }
            document.getElementById('txt-audit-link').innerText = translations[lang].auditLink;
            
            const modalEl = document.getElementById('biogen-detail-modal');
            if (modalEl && modalEl.classList.contains('active-modal')) {
                selectBiogenDirect(activeBiogenIndex);
            }
            logKernelMessage(`[SYSTEM] Idioma alterado para: ${lang}`);
        }

