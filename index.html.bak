                <button onclick="exibirStatusSegurancaUHNW()" title="Clique para verificar o status de segurança" style="display: inline-flex; align-items: center; gap: 5px; background: rgba(5,150,105,0.15); border: 1px solid rgba(5,150,105,0.5); padding: 5px 9px; border-radius: 6px; font-family: monospace; font-size: 8.5px; color: var(--green-secure); cursor: pointer; transition: all 0.2s ease;">
                    <span>🔑</span> <span id="key-shield-txt">KEY_SHIELD: 0x7F9B...3E41 [SECURE]</span>
                </button>
            </div>

            <div style="display: flex; gap: 8px; align-items: center;">
                <div style="display: flex; gap: 3px; background: rgba(59,94,102,0.1); padding: 2px; border-radius: 6px; border: 1px solid var(--border-sovereign);">
                    <button id="uhnw-lang-pt" class="lang-btn active-lang" onclick="mudarIdiomaModalUHNW('PT')" style="font-size: 9px; padding: 4px 7px;">PT</button>
                    <button id="uhnw-lang-en" class="lang-btn" onclick="mudarIdiomaModalUHNW('EN')" style="font-size: 9px; padding: 4px 7px;">EN</button>
                </div>
                <button class="hand-trigger-btn" onclick="salvarEvolucaoHistoricoUHNW()" style="font-size: 10.5px; padding: 8px 18px;"><span id="uhnw-btn-save">Salvar Evolução ✓</span></button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE CHECKOUT DA STRIPE COM DUPLA CAMADA DE BOTÕES DE RETORNO -->
<div id="stripe-checkout-modal" class="uhnw-modal-overlay">
    <div class="uhnw-modal-drawer" style="max-width: 540px;">
        <!-- CABEÇALHO DO CHECKOUT COM BOTÃO DE RETORNO NO TOPO -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-sovereign); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <button onclick="closeStripeModal()" class="lang-btn" title="Retornar ao Painel" style="font-size: 9.5px; padding: 5px 10px; display: flex; align-items: center; gap: 5px; border-color: var(--accent-clinical); color: var(--accent-clinical); cursor: pointer; font-weight: bold; background: rgba(59,94,102,0.1);">
                    <span>←</span> <span>Voltar ao Terminal Principal</span>
                </button>
