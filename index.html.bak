<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thierry Technology Concept Global • Monaco Tier-1 Audit Terminal</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* MODO ESCURO (PROFISSIONAL & IMERSIVO COM ALTA VISIBILIDADE) */
            --bg-carbon: #07090E;
            --panel-yacht-dark: #0E131F;
            --accent-clinical: #38BDF8;
            --border-sovereign: #1E293B;
            --cyan-tech-glow: #00F3FF;
            --green-secure: #059669;
            --purple-orbit: #6B21A8;
            --red-alert: #EF4444;
            --text-primary: #FFFFFF;
            --text-secondary: #94A3B8;
            --backlit-clinical-glow: 0 0 25px rgba(56, 189, 248, 0.1), inset 0 0 15px rgba(56, 189, 248, 0.04);
            --backlit-hover-glow: 0 0 35px rgba(56, 189, 248, 0.25), inset 0 0 20px rgba(56, 189, 248, 0.1);
            --btn-glass-bg: rgba(15, 23, 42, 0.95);
        }

        /* MODO CLARO (TELEMEDICINA & ESTÉTICA DE ALTO PADRÃO - LIMPO E ELEGANTE) */
        body.light-theme {
            --bg-carbon: #F4F6F9;
            --panel-yacht-dark: #FFFFFF;
            --accent-clinical: #0284C7;
            --border-sovereign: #CBD5E1;
            --text-primary: #0F172A;
            --text-secondary: #475569;
            --backlit-clinical-glow: 0 4px 20px rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(203, 213, 225, 0.6);
            --backlit-hover-glow: 0 6px 25px rgba(2, 132, 199, 0.15);
            --btn-glass-bg: #FFFFFF;
            background-color: var(--bg-carbon);
            color: var(--text-primary);
        }

        body.light-theme h1, body.light-theme h2, body.light-theme h3, body.light-theme h4, 
        body.light-theme strong, body.light-theme label, body.light-theme span {
            color: #0F172A !important;
        }

        body.light-theme p, body.light-theme div, body.light-theme li {
            color: #334155 !important;
        }

        body.light-theme input, body.light-theme select {
            color: #0F172A !important;
            background-color: #FFFFFF !important;
            border-color: #94A3B8 !important;
        }

        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: var(--bg-carbon); border-radius: 2px; }
        ::-webkit-scrollbar-thumb { background: var(--accent-clinical); border-radius: 2px; }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Space Grotesk', sans-serif; -webkit-font-smoothing: antialiased; transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease; }

        body {
            background-color: var(--bg-carbon);
            color: var(--text-primary);
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            padding: 20px 28px;
        }

        /* ESTILIZAÇÃO ESPECÍFICA PARA O MODO ESCURO (GARANTINDO VISIBILIDADE) */
        body:not(.light-theme) h1, body:not(.light-theme) h2, body:not(.light-theme) h3,
        body:not(.light-theme) h4, body:not(.light-theme) .brand-title-elite, body:not(.light-theme) strong {
            color: #ffffff;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        body:not(.light-theme) p, body:not(.light-theme) span, body:not(.light-theme) label,
        body:not(.light-theme) div, body:not(.light-theme) li {
            color: #e2e8f0;
            line-height: 1.6;
        }

        /* APRIMORAMENTO DOS CONTAINERS GRANDES COM CANTOS SUAVEMENTE ARREDONDADOS E ELEGANTE PADRÃO UHNW */
        body:not(.light-theme) .luxury-sidebar, 
        body:not(.light-theme) .dashboard-card-master, 
        body:not(.light-theme) .panel-container-macro {
            background-color: var(--panel-yacht-dark);
            border: 1px solid var(--border-sovereign);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            padding: 18px;
            gap: 12px;
            border-radius: 16px;
            overflow: hidden;
        }

        body:not(.light-theme) .lang-btn, body:not(.light-theme) .elite-menu-btn,
        body:not(.light-theme) button, body:not(.light-theme) .btn-action {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(56, 189, 248, 0.3);
            color: #ffffff;
            border-radius: 10px;
            padding: 8px 12px;
            backdrop-filter: blur(12px);
            font-size: 10px;
        }

        body:not(.light-theme) .lang-btn:hover, body:not(.light-theme) .elite-menu-btn:hover,
        body:not(.light-theme) button:hover {
            border-color: var(--accent-clinical);
            background: rgba(56, 189, 248, 0.12);
            box-shadow: var(--backlit-hover-glow);
            transform: translateY(-2px);
        }

        /* MODO CLARO - CONTAINERS GRANDES COM BORDAS SUAVES E FLUIDAS */
        body.light-theme .luxury-sidebar, 
        body.light-theme .dashboard-card-master, 
        body.light-theme .panel-container-macro {
            background-color: #FFFFFF;
            border: 1px solid var(--border-sovereign);
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            padding: 18px;
            border-radius: 16px;
            overflow: hidden;
        }

        body.light-theme .lang-btn, body.light-theme .elite-menu-btn, body.light-theme button {
            background: #FFFFFF;
            border: 1px solid #CBD5E1;
            color: #0F172A;
            border-radius: 10px;
            padding: 8px 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            font-size: 10px;
            font-weight: 600;
        }

        body.light-theme .lang-btn:hover, body.light-theme .elite-menu-btn:hover, body.light-theme button:hover {
            border-color: var(--accent-clinical);
            background: #F0F9FF;
            color: var(--accent-clinical);
            transform: translateY(-1px);
        }

        .client-input-field {
            background: var(--btn-glass-bg);
            border: 1px solid var(--border-sovereign);
            color: var(--text-primary);
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 10px;
            width: 100%;
            outline: none;
            backdrop-filter: blur(12px);
            transition: all 0.3s ease;
            margin: 8px 0;
        }
        .client-input-field:focus {
            border-color: var(--accent-clinical);
            box-shadow: var(--backlit-hover-glow);
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-sovereign);
            margin-bottom: 18px;
            flex-wrap: nowrap;
            gap: 15px;
            background: var(--panel-yacht-dark);
            border-radius: 14px;
            box-shadow: var(--backlit-clinical-glow);
            z-index: 100;
            position: relative;
        }
        
        body.light-theme header {
            background: #FFFFFF;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }

        .header-left-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .brand-title-elite { 
            font-size: 12px; 
            font-weight: 700; 
            letter-spacing: 1px; 
            text-transform: uppercase; 
            color: var(--text-primary);
            white-space: nowrap;
        }
        .brand-title-elite span.highlight-clinical { color: var(--accent-clinical); font-weight: 700; }

        .header-tier-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 8.5px;
            font-family: monospace;
            font-weight: 700;
            color: var(--accent-clinical);
            background: rgba(56, 189, 248, 0.08);
            border: 1px solid rgba(56, 189, 248, 0.25);
            padding: 2px 8px;
            border-radius: 6px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .system-meta-nodes { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            flex-wrap: nowrap;
            font-size: 10px;
        }

        .cinematic-cascade-container {
            display: none; 
            align-items: center;
            gap: 6px;
            flex-wrap: nowrap;
            opacity: 0;
            transform: translateX(-15px);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .cinematic-cascade-container.active-cascade {
            display: flex;
            opacity: 1;
            transform: translateX(0);
        }

        @keyframes cascadeSlideHorizontal {
            0% { opacity: 0; transform: translateX(-25px) scale(0.95); filter: blur(3px); }
            60% { opacity: 0.8; transform: translateX(4px) scale(1.01); filter: blur(0.5px); }
            100% { opacity: 1; transform: translateX(0) scale(1); filter: blur(0); }
        }

        @keyframes lightningGlowSweep {
            0% { box-shadow: 0 0 0px rgba(0, 243, 255, 0); border-color: var(--border-sovereign); }
            30% { box-shadow: 0 0 20px rgba(2, 132, 199, 0.4), inset 0 0 10px rgba(2, 132, 199, 0.2); border-color: var(--accent-clinical); }
            100% { box-shadow: 0 0 8px rgba(2, 132, 199, 0.15); border-color: var(--border-sovereign); }
        }

        .cascade-item {
            opacity: 0;
            animation: cascadeSlideHorizontal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            white-space: nowrap;
            padding: 6px 10px;
            font-size: 9.5px;
        }

        .cascade-item:nth-child(1) { animation-delay: 0.1s; }
        .cascade-item:nth-child(2) { animation-delay: 0.2s; }
        .cascade-item:nth-child(3) { animation-delay: 0.3s; }
        .cascade-item:nth-child(4) { animation-delay: 0.4s; }
        .cascade-item:nth-child(5) { animation-delay: 0.5s; }
        .cascade-item:nth-child(6) { animation-delay: 0.6s; }

        .lightning-sweep-active {
            animation: lightningGlowSweep 2s ease-in-out forwards;
        }

        .hand-trigger-btn {
            background: linear-gradient(135deg, var(--accent-clinical), #0369A1);
            color: #fff;
            border: 1px solid var(--cyan-tech-glow);
            border-radius: 10px;
            padding: 8px 14px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            transition: all 0.3s ease;
            white-space: nowrap;
            height: 32px;
        }
        .hand-trigger-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 0 20px rgba(2, 132, 199, 0.35);
        }

        .lang-selector { display: inline-flex; gap: 4px; }

        .ring-light-popup, .color-palette-popup {
            position: fixed; top: 75px; background: var(--panel-yacht-dark);
            border: 1px solid var(--border-sovereign); border-radius: 14px; padding: 14px 18px;
            box-shadow: var(--backlit-clinical-glow), 0 20px 40px rgba(0,0,0,0.2); display: none; flex-direction: column; gap: 10px; z-index: 99999;
            backdrop-filter: blur(25px); color: var(--text-primary);
        }
        .ring-light-popup { right: 280px; }
        .color-palette-popup { right: 150px; width: 240px; }
        .ring-light-popup.active-popup, .color-palette-popup.active-popup { display: flex; }

        .palette-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
        .palette-swatch { width: 32px; height: 32px; border-radius: 8px; cursor: pointer; border: 2px solid transparent; transition: transform 0.2s; }
        .palette-swatch:hover { transform: scale(1.15); border-color: var(--accent-clinical); }

        .dashboard-grid-master { display: grid; grid-template-columns: 310px 1fr 340px; gap: 20px; flex: 1; height: calc(100vh - 90px); }

        .category-header {
            font-size: 10px; letter-spacing: 1.5px; color: var(--accent-clinical);
            margin-bottom: 8px; border-bottom: 1px solid var(--border-sovereign); padding-bottom: 6px; text-transform: uppercase; font-weight: 700;
        }

        /* =====================================================================
           ESTILOS EXTRAS: BOTÃO LASER, BORDAS DE STATUS E NITIDEZ
           ===================================================================== */
        .btn-varredura-principal {
            background: rgba(24, 34, 48, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(110, 145, 185, 0.4);
            border-radius: 10px;
            color: #F0F4F8;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 14px 20px;
            width: 100%;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            -webkit-tap-highlight-color: transparent;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.14);
            transition: all 0.22s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        @media (hover: hover) {
            .btn-varredura-principal:hover {
                background: rgba(28, 42, 60, 0.94);
                border-color: #7DD3FC;
                color: #FFFFFF;
                box-shadow: 0 0 14px rgba(125, 211, 252, 0.45), inset 0 0 8px rgba(125, 211, 252, 0.25);
            }
        }
        .btn-varredura-principal:active {
            transform: scale(0.985);
            background: rgba(32, 50, 72, 0.98);
            border-color: #BAE6FD;
            color: #FFFFFF;
            box-shadow: 0 0 22px rgba(56, 189, 248, 0.85), 0 0 6px rgba(224, 242, 254, 0.95), inset 0 0 14px rgba(125, 211, 252, 0.55);
        }

        .card-auditoria { border-radius: 10px; border-width: 1.5px; border-style: solid; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
        .card-auditoria.status-verde { border-color: #16A34A; box-shadow: 0 2px 8px rgba(22, 163, 74, 0.12); }
        .card-auditoria.status-amarelo { border-color: #D97706; box-shadow: 0 2px 8px rgba(217, 119, 6, 0.12); }
        .card-auditoria.status-vermelho { border-color: #DC2626; box-shadow: 0 2px 8px rgba(220, 38, 38, 0.14); }

        /* Nitidez no Modo Claro */
        .card-id-auditoria, .texto-secundario-lateral, .label-metrica { color: #334155 !important; font-weight: 500; letter-spacing: 0.2px; }

        /* Correção de Contraste para o Modo Escuro */
        body:not(.light-theme) .card-id-auditoria,
        body:not(.light-theme) .texto-secundario-lateral,
        body:not(.light-theme) .label-metrica {
            color: #CBD5E1 !important;
        }

        /* =====================================================================
           ACESSIBILIDADE: RESPEITA USUÁRIOS SENSÍVEIS A ANIMAÇÕES
           ===================================================================== */
        @media (prefers-reduced-motion: reduce) {
            .btn-varredura-principal,
            .card-auditoria {
                transition: none !important;
            }
            .btn-varredura-principal:active {
                transform: none !important;
            }
        }

        /* =====================================================================
           RESPONSIVIDADE BLINDADA (TABLETS E CELULARES COM 100dvh)
           ===================================================================== */
        @media (max-width: 1100px) {
            body {
                height: auto !important;
                min-height: 100dvh;
                overflow-y: auto !important;
                overflow-x: hidden;
                padding: 14px 16px;
            }
            header {
                flex-wrap: wrap;
                gap: 10px;
            }
            .system-meta-nodes {
                flex-wrap: wrap;
                width: 100%;
                justify-content: flex-start;
            }
            .cinematic-cascade-container.active-cascade {
                flex-wrap: wrap;
            }
            .dashboard-grid-master {
                grid-template-columns: 280px 1fr;
                height: auto !important;
                gap: 16px;
            }
            .dashboard-grid-master > *:nth-child(3) {
                grid-column: 1 / -1;
            }
            .ring-light-popup { right: 20px; top: 110px; }
            .color-palette-popup { right: 20px; top: 110px; }
        }

        @media (max-width: 768px) {
            body {
                padding: 10px 12px;
                min-height: 100dvh;
            }
            .brand-title-elite {
                white-space: normal;
                font-size: 11px;
                line-height: 1.4;
            }
            .dashboard-grid-master {
                grid-template-columns: 1fr !important;
                display: flex;
                flex-direction: column;
                height: auto !important;
                gap: 14px;
            }
            .dashboard-grid-master > *:nth-child(3) {
                order: initial; 
            }
            .grid-cards, .dashboard-card-master .cards-container {
                grid-template-columns: repeat(2, 1fr) !important;
            }
            .ring-light-popup,
            .color-palette-popup {
                right: 12px;
                left: 12px;
                width: auto;
                top: 125px;
            }
        }

        @media (max-width: 480px) {
            .grid-cards, .dashboard-card-master .cards-container {
                grid-template-columns: 1fr !important;
            }
        }
    </style>

    
    <style id="auditor-tcc-styles">
        /* ORGANIZAÇÃO VISUAL, RESPIRO E SUAVIZAÇÃO DE BORDAS */
        .biogen-imperial-grid {
            gap: 18px !important;
            padding: 22px !important;
        }
        .grid-cell {
            padding: 14px !important;
            border-width: 1px !important;
            border-radius: 10px !important;
            transition: transform 0.2s ease, box-shadow 0.2s ease !important;
        }
        .grid-cell:hover {
            transform: translateY(-2px) !important;
        }

        /* PROTEÇÃO DE CONTRASTE NO MODO CLARO */
        body.light-theme,
        body.light-mode,
        html[data-theme="light"] body {
            background-color: #f8fafc !important;
            color: #0f172a !important;
            --card-final-bg: #ffffff !important;
            --text-biogen-title: #0f172a !important;
            --text-biogen-metadata: #047857 !important;
        }
        body.light-theme :is(h1, h2, h3, h4, p, span, label, small, div, td, th),
        body.light-mode :is(h1, h2, h3, h4, p, span, label, small, div, td, th),
        html[data-theme="light"] :is(h1, h2, h3, h4, p, span, label, small, div, td, th) {
            color: #0f172a !important;
        }
        body.light-theme .metadata,
        body.light-mode .metadata,
        html[data-theme="light"] .metadata {
            color: #047857 !important;
        }
    </style>
    

    <style id="auditor-refino-metricas">
        /* AFINA SUAVEMENTE OS CARTÕES DE MÉTRICAS SEM ALTERAR A ESTRUTURA */
        .metric-card, .telemetry-card, [class*="metric-item"], [class*="telemetry-box"] {
            padding-top: 7px !important;
            padding-bottom: 7px !important;
            min-height: unset !important;
        }
        .metric-card .metric-value, .telemetry-card .metric-value {
            font-size: 0.92rem !important;
            line-height: 1.2 !important;
        }
    </style>
    

    <style id="auditor-silicio-ui">
        body {
            -webkit-font-smoothing: antialiased !important;
            -moz-osx-font-smoothing: grayscale !important;
            font-variant-numeric: tabular-nums !important;
        }
        .luxury-sidebar {
            gap: 10px !important;
        }
        .elite-menu-btn {
            border-radius: 10px !important;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }
        .biogen-imperial-grid {
            gap: 16px !important;
            padding: 20px !important;
        }
        .grid-cell {
            border-radius: 12px !important;
            transition: transform 0.2s ease !important;
        }
    </style>
    
</head>
<body class="light-theme">
    <header>
        <div class="header-left-group">
            <div class="brand-title-elite" id="header-brand-title">
                THIERRY TECHNOLOGY CONCEPT GLOBAL 
                <span id="header-subtitle" class="highlight-clinical">• TELEMEDICINE COMPLIANCE TERMINAL v5.3</span>
            </div>
            <div class="header-tier-badge">
                <span id="txt-audit-link">🛡️ AUDIT TIER-1</span>
                <span>•</span>
                <span style="color:var(--cyan-tech-glow);" id="header-dynamic-company">[TTC Global Corp]</span>
            </div>
        </div>

        <div class="system-meta-nodes">
            <!-- BOTÃO DA MÃO (AJUSTES) ALINHADO PERFEITAMENTE COM OS DEMAIS CONTROLES -->
            <button class="hand-trigger-btn" onclick="toggleRetractableSettings()" title="Expandir/Recolher Ajustes">
                🖐️ <span id="txt-hand-btn">AJUSTES</span>
            </button>

            <!-- CONTAINER DOS BOTÕES COM ANIMAÇÃO EM CASCATA HORIZONTAL -->
            <div id="retractable-controls-box" class="cinematic-cascade-container">
                <button id="btn-toggle-camera" class="lang-btn cascade-item" onclick="toggleCameraPowerSafe()" title="Ligar/Desligar Câmera">
                    📷 <span id="txt-cam-state">CAM: BLOQUEADA</span>
                </button>

                <button id="btn-toggle-ring-main" class="lang-btn cascade-item" onclick="toggleRingLightPopup()" title="Ajustes da Ring Light">
                    💡 <span data-i18n="lbl-ring-title">RING LIGHT</span>
                </button>

                <button id="btn-toggle-theme" class="lang-btn cascade-item" onclick="toggleThemeModeSafe()" title="Alternar Modo Diurno / Noturno">
                    <span id="theme-icon">☀️</span> <span data-i18n="lbl-mode-title">MODO</span>
                </button>

                <button class="lang-btn cascade-item" onclick="toggleColorPalettePopup()" title="Paleta de Cores Internacionais">
                    🎨 <span data-i18n="lbl-palette-title">PALETA</span>
                </button>

                <button class="lang-btn cascade-item" id="btn-sovereign-clock" title="Horário Soberano Global">
                    🕒 <span id="txt-clock-display">11:27 PM</span>
                </button>

                <div class="lang-selector cascade-item">
                    <button id="btn-pt" class="lang-btn active-lang" onclick="changeSystemLanguage('PT')">PT</button>
                    <button id="btn-en" class="lang-btn" onclick="changeSystemLanguage('EN')">EN</button>
                </div>
            </div>
        </div>
    </header>

    <div id="ring-light-popup-box" class="ring-light-popup">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--accent-clinical); font-weight: 700;">
            <span data-i18n="ring-popup-hdr">CONTROLE DE RING LIGHT</span>
            <button onclick="toggleRingLightPopup()" style="background:none; border:none; color:var(--text-primary); cursor:pointer; font-size:12px;">✕</button>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 10px;">
            <button id="btn-toggle-ring" class="lang-btn" onclick="toggleRingLight()" style="padding: 3px 8px; font-size:9px;" data-i18n="ring-toggle-btn">LIGAR/DESLIGAR</button>
            <label for="ringIntensityRange" data-i18n="ring-intensity-lbl">Intensidade:</label>
            <input type="range" id="ringIntensityRange" min="0.1" max="2.5" step="0.1" value="1.2" oninput="updateRingIntensity(this.value)" style="width: 70px; accent-color: var(--accent-clinical); cursor: pointer;">
        </div>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 10px;">
            <label for="ringTempSelect" data-i18n="ring-temp-lbl">Temperatura:</label>
            <select id="ringTempSelect" class="client-input-field" onchange="updateRingColor(this.value)" style="padding:3px; font-size:9px; margin:0; flex:1;">
                <option value="gold" data-i18n="opt-gold">Branco Quente (Gold)</option>
                <option value="neutral" data-i18n="opt-neutral">Branco Neutro</option>
                <option value="studio" data-i18n="opt-studio">Estúdio Clínico</option>
            </select>
        </div>
    </div>

    <div id="color-palette-popup-box" class="color-palette-popup">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px; color: var(--accent-clinical); font-weight: 700;">
            <span data-i18n="palette-popup-hdr">PALETA DE CORES UHNW</span>
            <button onclick="toggleColorPalettePopup()" style="background:none; border:none; color:var(--text-primary); cursor:pointer; font-size:12px;">✕</button>
        </div>
        <div style="font-size: 9px; color: var(--text-secondary);" data-i18n="palette-sub-lbl">Selecione o padrão clínico internacional:</div>
        <div class="palette-grid">
            <div class="palette-swatch" style="background: #0284C7;" onclick="applyClinicalPalette('#0284C7')" title="Azul Telemedicina"></div>
            <div class="palette-swatch" style="background: #0369A1;" onclick="applyClinicalPalette('#0369A1')" title="Azul Mônaco Tech"></div>
            <div class="palette-swatch" style="background: #059669;" onclick="applyClinicalPalette('#059669')" title="Verde Seguro Vascular"></div>
            <div class="palette-swatch" style="background: #7C3AED;" onclick="applyClinicalPalette('#7C3AED')" title="Roxo Órbita UHNW"></div>
            <div class="palette-swatch" style="background: #D97706;" onclick="applyClinicalPalette('#D97706')" title="Ouro Titanum Apex"></div>
        </div>
        <div style="margin-top: 4px;">
            <label style="font-size: 9px; color: var(--text-secondary);" data-i18n="palette-custom-lbl">Cor Customizada:</label>
            <input type="color" id="customColorPicker" value="#0284C7" onchange="applyClinicalPalette(this.value)" style="width: 100%; height: 26px; border: 1px solid var(--border-sovereign); border-radius: 6px; background: none; cursor: pointer; padding: 0;">
        </div>
    </div>

    <script>
        // Efeito sonoro de neuromarketing para cliques e interações
        function playClinicalChimeSafe() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1760, audioCtx.currentTime + 0.15);
                
                gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.25);
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                osc.start();
                osc.stop(audioCtx.currentTime + 0.25);
            } catch (e) {}
        }

        let isControlsExpanded = false;
        function toggleRetractableSettings() {
            playClinicalChimeSafe();
            const box = document.getElementById('retractable-controls-box');
            if (!box) return;
            isControlsExpanded = !isControlsExpanded;
            if (isControlsExpanded) {
                box.classList.add('active-cascade');
                setTimeout(() => {
                    box.classList.add('lightning-sweep-active');
                    setTimeout(() => {
                        box.classList.remove('lightning-sweep-active');
                    }, 2000);
                }, 100);
            } else {
                box.classList.remove('active-cascade');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            setInterval(() => {
                const now = new Date();
                const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                const clockEl = document.getElementById('txt-clock-display');
                if (clockEl) clockEl.textContent = timeString;
            }, 1000);
        });

        function toggleCameraPowerSafe() {
            playClinicalChimeSafe();
            if (typeof toggleCameraPower === 'function') {
                toggleCameraPower();
            }
        }

        function toggleThemeModeSafe() {
            playClinicalChimeSafe();
            document.body.classList.toggle("light-theme");
            const isLight = document.body.classList.contains("light-theme");
            const icon = document.getElementById("theme-icon");
            if (icon) icon.innerText = isLight ? "☀️" : "🌙";
            
            if (typeof toggleThemeMode === 'function') {
                toggleThemeMode();
            }
        }
    </script>
</body>
</html><div class="dashboard-grid-master">
        <aside class="luxury-sidebar" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
            <div>
                <div class="category-header" id="cat-morph-analysis" data-i18n="cat-sync-compliance">Sync Global Compliance</div>
                <div class="sub-tag-label" id="lbl-profiles" data-i18n="lbl-pillars" style="margin-bottom: 8px;">Pilares de Soberania Clínica</div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <button id="btn-perf-lideranca" class="elite-menu-btn" onclick="dispararVarreduraComGateway('lideranca')" data-i18n="btn-lideranca">Autoliderança & Comando Global</button>
                    <button id="btn-perf-vitalidade" class="elite-menu-btn" onclick="dispararVarreduraComGateway('clinica')" data-i18n="btn-clinica">Clínica & Rejuvenescimento Facial</button>
                    <button id="btn-perf-poder" class="elite-menu-btn" onclick="dispararVarreduraComGateway('tricologia')" data-i18n="btn-tricologia">Visagismo & Tricologia Avançada</button>
                </div>

                <div class="category-header" style="margin-top: 18px;" id="cat-regen" data-i18n="cat-regen">Global Clinical Compliance</div>
                <div class="sub-tag-label" id="lbl-posture-metrics" data-i18n="lbl-posture" style="margin-bottom: 8px;">Telemetria Biométrica Avançada</div>
                
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <!-- Métrica 1: Integridade Tecidual -->
                    <div style="background: rgba(59, 94, 102, 0.08); border: 1px solid var(--border-sovereign); padding: 5px 10px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: var(--text-secondary); display: block; font-size: 8.5px; text-transform: uppercase;">Integridade Tecidual</span>
                            <span id="metric-val-integridade" style="color: var(--accent-clinical); font-weight: 700; font-size: 10px;">99.4% — Estável</span>
                        </div>
                        <span style="width: 6px; height: 6px; background: #38bdf8; border-radius: 50%; box-shadow: 0 0 8px #38bdf8;" title="Ativo no Motor"></span>
                    </div>

                    <!-- Métrica 2: Colágeno Apex -->
                    <div style="background: rgba(59, 94, 102, 0.08); border: 1px solid var(--border-sovereign); padding: 5px 10px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: var(--text-secondary); display: block; font-size: 8.5px; text-transform: uppercase;">Colágeno Apex</span>
                            <span id="metric-val-colageno" style="color: var(--green-secure); font-weight: 700; font-size: 10px;">98.8% — Ótimo</span>
                        </div>
                        <span style="width: 6px; height: 6px; background: #059669; border-radius: 50%; box-shadow: 0 0 8px #059669;" title="Sincronizado"></span>
                    </div>

                    <!-- Métrica 3: Valor Hídrico -->
                    <div style="background: rgba(59, 94, 102, 0.08); border: 1px solid var(--border-sovereign); padding: 5px 10px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: var(--text-secondary); display: block; font-size: 8.5px; text-transform: uppercase;">Valor Hídrico (Hidratação)</span>
                            <span id="metric-val-hidrico" style="color: #f59e0b; font-weight: 700; font-size: 10px;">88.5% — Balanceado</span>
                        </div>
                        <span style="width: 6px; height: 6px; background: #f59e0b; border-radius: 50%; box-shadow: 0 0 8px #f59e0b;" title="Monitorado"></span>
                    </div>
                </div>
            </div>

            <!-- Bloco Inferior de Alinhamento e Governança Global -->
            <div style="margin-top: 15px; border-top: 1px solid var(--border-sovereign); padding-top: 12px;">
                <div class="category-header" style="margin-bottom: 6px;">Governança de Sincronia</div>
                <div style="background: rgba(59, 94, 102, 0.08); border: 1px solid var(--border-sovereign); padding: 6px 10px; border-radius: 10px;">
                    <span style="color: var(--text-secondary); display: block; font-size: 8.5px; letter-spacing: 0.4px;">STATUS DO NÚCLEO GLOBAL</span>
                    <span style="color: var(--text-primary); font-weight: 700; font-size: 11px;">Sincronizado • 64 Nós Ativos</span>
                </div>
            </div>
        </aside><main class="center-stage-container">
    <style>
        /* ==========================================================
           PIPELINE MESTRE DEFINITIVO: PORTAS SUAVES, DUPLO SCANNER,
           BLINDAGEM COMPATÍVEL COM body:not(.light-theme) & dark-mode
           ========================================================== */
        * {
            transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                        border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                        color 0.2s ease !important;
        }

        /* Padrão Light Theme (Padrão Inicial) */
        :root {
            --card-final-bg: rgba(248, 250, 252, 0.92);
            --text-biogen-title: #0e121a;       
            --text-biogen-metadata: #047857;    
            --id-footer-color: #b45309; 
        }

        /* Padrão Dark Theme (Compatível com body:not(.light-theme) e body.dark-mode) */
        body:not(.light-theme), body.dark-mode {
            --card-final-bg: rgba(11, 15, 25, 0.90);
            --text-biogen-title: #f8fafc;
            --text-biogen-metadata: #34d399; 
            --id-footer-color: #fbbf24;
        }

        .center-stage-container { display: flex; flex-direction: column; gap: 16px; height: 100%; box-sizing: border-box; }
        
        .viewport-central-master {
            flex: 1; background: var(--panel-yacht-dark, #0b0f17); border: 1px solid var(--border-sovereign, rgba(59, 94, 102, 0.4)); border-radius: 16px;
            position: relative; overflow: hidden; box-shadow: var(--backlit-clinical-glow, 0 0 40px rgba(59, 94, 102, 0.15)), 0 0 60px rgba(59, 94, 102, 0.08);
            perspective: 1500px;
        }
        
        .stage-pane { width: 100%; height: 100%; display: none; position: absolute; top: 0; left: 0; opacity: 0; transition: opacity 0.8s ease-in-out; }
        .stage-pane.active-pane { display: block; opacity: 1; }
        
        .camera-hud-layout { display: flex; flex-direction: column; padding: 12px; height: 100%; background: var(--panel-yacht-dark, #0b0f17); position: relative; }
        
        .camera-viewport-wrapper { 
            border: 1px solid var(--border-sovereign, rgba(59, 94, 102, 0.4)); 
            border-radius: 16px; 
            position: relative; 
            overflow: hidden; 
            background: var(--bg-carbon, #020408); 
            flex: 1; 
        }

        #webcam-feed-main { 
            width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); position: absolute; top: 0; left: 0; z-index: 1; 
            filter: contrast(1.05) saturate(1.05) brightness(calc(1.1 + var(--ring-intensity, 0) * 0.25));
        }
        #overlay-canvas-3d { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
        .radar-hud-circle {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 200px; height: 200px;
            border: 1px dashed rgba(59, 94, 102, 0.45); border-radius: 50%; z-index: 3; pointer-events: none; animation: rotateRadar 20s linear infinite;
        }
        @keyframes rotateRadar { from { transform: translate(-50%, -50%) rotate(0deg); } to { transform: translate(-50%, -50%) rotate(360deg); } }
        
        .viewport-central-master::after {
            content: ''; position: absolute; inset: 0; border-radius: 16px; pointer-events: none;
            box-shadow: inset 0 0 0 1px rgba(59, 94, 102, 0.25); z-index: 5;
        }
        
        #biogens-flying-ticker {
            position: absolute; bottom: 15px; left: 15px; right: 15px; height: 50px; background: rgba(3, 5, 8, 0.88);
            border-top: 1px solid var(--accent-clinical, #3b5e66); border-bottom: 1px solid var(--accent-clinical, #3b5e66);
            z-index: 10; display: none; overflow: hidden; align-items: center; backdrop-filter: blur(10px);
            border-radius: 8px;
        }
        #biogens-flying-ticker.active-ticker { display: flex; }
        .ticker-track { display: flex; gap: 12px; position: absolute; white-space: nowrap; animation: tickerSlide 7.5s linear forwards; }
        @keyframes tickerSlide { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
        .ticker-item { width: 68px; height: 40px; border: 1px solid var(--accent-clinical, #3b5e66); border-radius: 6px; overflow: hidden; background: #000; flex-shrink: 0; position: relative; }
        .ticker-item canvas { width: 100%; height: 100%; object-fit: cover; }
        
        .biogen-imperial-grid { 
            display: grid; 
            grid-template-columns: repeat(5, 1fr); 
            grid-template-rows: repeat(2, minmax(0, 1fr)); 
            gap: 12px; 
            padding: 16px; 
            height: calc(100% - 60px); 
            background: var(--panel-yacht-dark, #0b0f17); 
            overflow: hidden; 
            box-sizing: border-box; 
            position: relative;
        }

        /* PORTAS LUMINOSAS LATERAIS */
        .biogen-imperial-grid::before {
            content: '';
            position: absolute;
            top: 0; bottom: 0; left: 0; width: 70px;
            background: linear-gradient(90deg, rgba(212, 175, 55, 0.9) 0%, rgba(245, 158, 11, 0.35) 50%, rgba(0,0,0,0) 100%);
            box-shadow: 0 0 40px rgba(212, 175, 55, 0.95);
            z-index: 30;
            pointer-events: none;
            opacity: 0;
            animation: sideLightDoorFlashSlow 2.2s cubic-bezier(0.25, 1, 0.5, 1) 1 forwards;
        }

        .biogen-imperial-grid::after {
            content: '';
            position: absolute;
            top: 0; bottom: 0; right: 0; width: 70px;
            background: linear-gradient(-90deg, rgba(212, 175, 55, 0.9) 0%, rgba(245, 158, 11, 0.35) 50%, rgba(0,0,0,0) 100%);
            box-shadow: 0 0 40px rgba(212, 175, 55, 0.95);
            z-index: 30;
            pointer-events: none;
            opacity: 0;
            animation: sideLightDoorFlashSlow 2.2s cubic-bezier(0.25, 1, 0.5, 1) 1 forwards;
        }

        @keyframes sideLightDoorFlashSlow {
            0% { opacity: 0; filter: brightness(0.3); }
            30% { opacity: 1; filter: brightness(1.6); }
            70% { opacity: 0.85; filter: brightness(1.1); }
            100% { opacity: 0; filter: brightness(1); }
        }

        @keyframes biogenSideDoorSlideSlowLeft {
            0% { transform: translateX(-140vw) scale(0.5); opacity: 0; filter: blur(12px); }
            50% { opacity: 0.7; filter: blur(4px); }
            100% { transform: translateX(0) scale(1); opacity: 1; filter: blur(0px); }
        }

        @keyframes biogenSideDoorSlideSlowRight {
            0% { transform: translateX(140vw) scale(0.5); opacity: 0; filter: blur(12px); }
            50% { opacity: 0.7; filter: blur(4px); }
            100% { transform: translateX(0) scale(1); opacity: 1; filter: blur(0px); }
        }

        .grid-cell {
            background: var(--card-final-bg) !important;
            border: 1px solid rgba(148, 163, 184, 0.4) !important;
            backdrop-filter: blur(12px);
            position: relative;
            overflow: hidden;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 10px;
            height: 100%;
            width: 100%;
            border-radius: 12px;
            box-sizing: border-box;
            transform-origin: center center;
            will-change: transform, opacity, background-color, border-color, box-shadow, filter;
            transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease, border-color 0.3s ease;
        }

        .grid-cell:nth-child(1) { animation-delay: 0.08s; }
        .grid-cell:nth-child(2) { animation-delay: 0.14s; }
        .grid-cell:nth-child(3) { animation-delay: 0.20s; }
        .grid-cell:nth-child(4) { animation-delay: 0.26s; }
        .grid-cell:nth-child(5) { animation-delay: 0.32s; }
        .grid-cell:nth-child(6) { animation-delay: 0.38s; }
        .grid-cell:nth-child(7) { animation-delay: 0.44s; }
        .grid-cell:nth-child(8) { animation-delay: 0.50s; }
        .grid-cell:nth-child(9) { animation-delay: 0.56s; }
        .grid-cell:nth-child(10) { animation-delay: 0.62s; }

        .grid-cell.safe { border-color: #059669 !important; }
        .grid-cell.alert { border-color: #dc2626 !important; }
        
        .grid-cell.gold { 
            border-color: #f59e0b !important; 
            box-shadow: 0 0 25px rgba(245, 158, 11, 0.45), inset 0 0 15px rgba(245, 158, 11, 0.25) !important;
        }

        /* SCANNERS DE LASER */
        .cell-photo-placeholder::before {
            content: '';
            position: absolute;
            left: 0; right: 0; height: 4px;
            background: linear-gradient(to bottom, rgba(56,189,248,0), rgba(14,165,233,1) 50%, rgba(56,189,248,0.9) 100%);
            box-shadow: 0 0 18px rgba(14, 165, 233, 0.95), 0 0 8px rgba(56, 189, 248, 0.8);
            z-index: 28;
            top: -10px;
            pointer-events: none;
            animation: firstSlowScannerPass 2.6s cubic-bezier(0.37, 0, 0.63, 1) 1.8s forwards;
        }

        @keyframes firstSlowScannerPass {
            0% { top: -10px; opacity: 0; }
            15% { opacity: 1; }
            85% { top: 100%; opacity: 1; filter: drop-shadow(0 0 10px #38bdf8); }
            100% { top: 100%; opacity: 0; }
        }

        .cell-photo-placeholder::after {
            content: '';
            position: absolute;
            left: 0; right: 0; height: 5px;
            background: linear-gradient(to bottom, rgba(52,211,153,0), rgba(52,211,153,1) 50%, rgba(255,255,255,1) 100%);
            box-shadow: 0 0 22px rgba(52, 211, 153, 1), 0 0 10px rgba(255, 255, 255, 0.9);
            z-index: 27;
            top: -10px;
            pointer-events: none;
            opacity: 0;
            animation: secondSlowTranslucentCleaner 3.5s cubic-bezier(0.37, 0, 0.63, 1) 4.8s forwards;
        }

        @keyframes secondSlowTranslucentCleaner {
            0% { top: -10px; opacity: 0; }
            10% { opacity: 1; }
            90% { top: 100%; opacity: 1; filter: drop-shadow(0 0 15px #34d399); }
            100% { top: 100%; opacity: 0; }
        }

        /* ==========================================================
           SEQUÊNCIA PÓS-SCANNERS RETORNANDO PARA A VARIÁVEL DE TEMA
           ========================================================== */
        @keyframes darkCardsClearPhotosGoldPulsesToTranslucent {
            0% { background: var(--card-final-bg) !important; }
            15% { background: #05080f !important; border-color: rgba(212, 175, 55, 0.7) !important; box-shadow: 0 0 22px rgba(212, 175, 55, 0.4); }
            28% { background: #05080f !important; box-shadow: 0 0 35px rgba(245, 158, 11, 0.85), inset 0 -15px 25px rgba(212, 175, 55, 0.6); border-color: rgba(245, 158, 11, 1) !important; }
            36% { background: #05080f !important; box-shadow: 0 0 15px rgba(212, 175, 55, 0.3), inset 0 -8px 12px rgba(212, 175, 55, 0.3); border-color: rgba(212, 175, 55, 0.5) !important; }
            44% { background: #05080f !important; box-shadow: 0 0 35px rgba(245, 158, 11, 0.85), inset 0 -15px 25px rgba(212, 175, 55, 0.6); border-color: rgba(245, 158, 11, 1) !important; }
            52% { background: #05080f !important; box-shadow: 0 0 15px rgba(212, 175, 55, 0.3), inset 0 -8px 12px rgba(212, 175, 55, 0.3); border-color: rgba(212, 175, 55, 0.5) !important; }
            60% { background: #05080f !important; box-shadow: 0 0 42px rgba(245, 158, 11, 0.95), inset 0 -18px 30px rgba(212, 175, 55, 0.75); border-color: rgba(245, 158, 11, 1) !important; }
            80% { background: #05080f !important; border-color: rgba(212, 175, 55, 0.8) !important; }
            100% {
                background: var(--card-final-bg) !important;
                backdrop-filter: blur(14px);
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25), inset 0 0 14px rgba(212, 175, 55, 0.15);
                border-color: rgba(212, 175, 55, 0.75) !important;
            }
        }

        .grid-cell:nth-child(odd) {
            animation: biogenSideDoorSlideSlowLeft 1.8s cubic-bezier(0.25, 1, 0.5, 1) 1 forwards,
                       darkCardsClearPhotosGoldPulsesToTranslucent 7.5s cubic-bezier(0.25, 1, 0.5, 1) 8.5s 1 forwards;
        }

        .grid-cell:nth-child(even) {
            animation: biogenSideDoorSlideSlowRight 1.8s cubic-bezier(0.25, 1, 0.5, 1) 1 forwards,
                       darkCardsClearPhotosGoldPulsesToTranslucent 7.5s cubic-bezier(0.25, 1, 0.5, 1) 8.5s 1 forwards;
        }

        .cell-photo-placeholder { filter: brightness(1.18) contrast(1.08) !important; }

        .viewport-central-master::before {
            content: '';
            position: absolute;
            left: 0; right: 0; height: 5px;
            background: linear-gradient(90deg, rgba(212,175,55,0), rgba(245,158,11,1) 20%, rgba(255,255,255,1) 50%, rgba(245,158,11,1) 80%, rgba(212,175,55,0));
            box-shadow: 0 0 25px rgba(245, 158, 11, 1), 0 0 50px rgba(255, 255, 255, 0.8);
            z-index: 25;
            top: -10px;
            pointer-events: none;
            opacity: 0;
            animation: finalFeixeLaserScan 2.4s cubic-bezier(0.37, 0, 0.63, 1) 13.2s forwards;
        }

        @keyframes finalFeixeLaserScan {
            0% { top: -10px; opacity: 0; }
            15% { opacity: 1; }
            85% { top: 100%; opacity: 1; filter: drop-shadow(0 0 15px #f59e0b); }
            100% { top: 100%; opacity: 0; }
        }

        @keyframes photo3DProjectionWheelY {
            0% { transform: rotateY(0deg) scale(1) translateZ(0px); }
            35% { transform: rotateY(180deg) scale(1.12) translateZ(65px); filter: brightness(1.25); }
            70% { transform: rotateY(360deg) scale(1.05) translateZ(35px); filter: brightness(1.18); }
            100% { transform: rotateY(360deg) scale(1) translateZ(0px); filter: brightness(1.15); }
        }

        .cell-photo-placeholder canvas { 
            width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; display: block; 
            transform-style: preserve-3d;
            animation: photo3DProjectionWheelY 2.6s cubic-bezier(0.4, 0, 0.2, 1) 15.8s 1 forwards;
        }

        @keyframes textRevealMaster {
            0%, 40% { opacity: 0; transform: translateY(4px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .cell-title {
            font-size: 8.5px; 
            font-family: 'Courier New', Courier, monospace; 
            color: var(--text-biogen-title) !important;
            background: transparent !important;
            padding: 1px 2px; 
            padding-right: 52px; 
            text-transform: uppercase;
            letter-spacing: 0.4px; 
            z-index: 5; 
            line-height: 1.2; 
            height: 20px; 
            display: flex; 
            align-items: center;
            overflow: hidden; 
            text-overflow: ellipsis; 
            white-space: nowrap; 
            font-weight: 900; 
            opacity: 1 !important;
