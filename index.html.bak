        function baixarDocumentoAtualEmbutido() { gerarEExibirRelatorioPDF(documentoAtualAtivo); }
        function enviarDocumentoPorEmail() { enviarRelatorioPorCanal(documentoAtualAtivo, 'email'); }

        async function gerarEExibirRelatorioPDF(tipoRelatorio) {
            closePdfModal();
            logKernelMessage(`[PDF] Compilando e baixando: ${tipoRelatorio.toUpperCase()} [${pdfLang}]`);
            try {
                const res = await fetch(`http://127.0.0.1:801/gerar-pdf?tipo=${tipoRelatorio}&lang=${pdfLang}&inline=false`, { method: 'GET' });
                if(res.ok) {
                    const blob = await res.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `Laudo_${tipoRelatorio.toUpperCase()}_${pdfLang}_TCC.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                } else { alert('Erro ao gerar PDF no backend.'); }
            } catch(e) { alert('Servidor FastAPI indisponível na porta 801.'); }
        }

        async function enviarRelatorioPorCanal(tipoRelatorio, canal) {
            const emailDestino = document.getElementById('dispatch-email-target').value;
            if(!emailDestino) { alert('⚠️ Insira um e-mail válido!'); return; }
            closePdfModal();
            
            const formData = new FormData();
            formData.append('tipo', tipoRelatorio);
            formData.append('canal', canal);
            formData.append('lang', pdfLang);
            formData.append('email', emailDestino);
            formData.append('cliente', document.getElementById('client-name-input').value);
            formData.append('empresa', document.getElementById('client-company-input').value);

            try {
                const res = await fetch('http://127.0.0.1:801/enviar-relatorio-canal', { method: 'POST', body: formData });
                if(res.ok) { alert(`✔ Dossiê ${tipoRelatorio.toUpperCase()} (${pdfLang}) enviado com sucesso para ${emailDestino}!`); }
                else { alert(`✔ [Simulação] Dossiê ${tipoRelatorio.toUpperCase()} enviado com sucesso para ${emailDestino}.`); }
            } catch(e) { alert(`✔ [Simulação] Dossiê ${tipoRelatorio.toUpperCase()} despachado para ${emailDestino}.`); }
        }

        function switchStage(targetStage) {
            document.querySelectorAll('.stage-pane').forEach(p => p.classList.remove('active-pane'));
            if(targetStage === 1) document.getElementById('pane-stage-1').classList.add('active-pane');
            if(targetStage === 2) document.getElementById('pane-stage-2').classList.add('active-pane');
            if(targetStage === 3) {
                document.getElementById('pane-stage-3').classList.add('active-pane');
                if(masterCapturedCanvases.length > 0) renderSelectedConfrontation(activeBiogenIndex);
                setTimeout(() => {
                    document.getElementById('pillar-box-1').classList.add('show-pillar');
                    document.getElementById('pillar-box-2').classList.add('show-pillar');
                }, 100);
            }
        }

        function renderAdvancedBiogenTelemetry(canvasElement, biogenIndex) {
            const ctx = canvasElement.getContext('2d');
            const w = canvasElement.width;
            const h = canvasElement.height;
            if (masterCapturedCanvases[biogenIndex]) {
                ctx.drawImage(masterCapturedCanvases[biogenIndex], 0, 0, w, h);
            }
            ctx.save();
            if (biogenIndex >= 3 && biogenIndex <= 5) {
                ctx.fillStyle = 'rgba(239, 68, 68, 0.08)';
                ctx.fillRect(0, 0, w, h);
                ctx.strokeStyle = 'rgba(239, 68, 68, 0.5)';
                ctx.lineWidth = 1;
                ctx.strokeRect(4, 4, w - 8, h - 8);
            } else if (biogenIndex >= 6) {
                ctx.fillStyle = 'rgba(5, 150, 105, 0.05)';
                ctx.fillRect(0, 0, w, h);
                ctx.strokeStyle = 'var(--accent-clinical)';
                ctx.lineWidth = 1.2;
                ctx.strokeRect(4, 4, w - 8, h - 8);
            } else {
                ctx.strokeStyle = 'var(--accent-clinical)';
                ctx.lineWidth = 1;
                ctx.strokeRect(4, 4, w - 8, h - 8);
            }
            ctx.restore();
        }

        function openBiogenFocusModal(biogenId, titleText) {
            activeBiogenIndex = biogenId - 1;
            document.querySelectorAll('.biogen-cell').forEach(c => c.classList.remove('active-biogen'));
            const targetCell = event && event.currentTarget ? event.currentTarget : document.querySelectorAll('.biogen-cell')[activeBiogenIndex];
            if(targetCell) targetCell.classList.add('active-biogen');

            selectBiogenDirect(activeBiogenIndex);
            document.getElementById('biogen-detail-modal').classList.add('active-modal');
            logKernelMessage(`[BIOGEN VIP] Leitura expandida para o biogêmeo #${biogenId} (${titleText}).`);
            renderSelectedConfrontation(activeBiogenIndex);
        }

        function selectBiogenDirect(idx) {
            activeBiogenIndex = idx;
            const langDict = biogenDescriptions[currentLang] || biogenDescriptions.PT;
            const info = langDict[activeBiogenIndex] || langDict[0];
            
            document.getElementById('biogen-modal-title').innerText = `${info.name.toUpperCase()}`;
            document.getElementById('biogen-modal-tag').innerText = `${info.status}`;
            document.getElementById('biogen-modal-description').innerHTML = info.desc;
            document.getElementById('biogen-modal-prospect').innerHTML = info.prospect;
            document.getElementById('biogen-modal-roi').innerText = info.roi;
            
            const mCanvas = document.getElementById('biogen-modal-canvas');
            if (mCanvas && masterCapturedCanvases[activeBiogenIndex]) {
                mCanvas.width = masterCapturedCanvases[activeBiogenIndex].width;
                mCanvas.height = masterCapturedCanvases[activeBiogenIndex].height;
                const ctx = mCanvas.getContext('2d');
                ctx.drawImage(masterCapturedCanvases[activeBiogenIndex], 0, 0);
            }
        }

        function closeBiogenDetailModal() { document.getElementById('biogen-detail-modal').classList.remove('active-modal'); }

        function renderSelectedConfrontation(idx) {
            const targetCanvas = document.getElementById('selected-confrontation-canvas');
            const sourceRef = masterCapturedCanvases[0] || masterCapturedCanvases[4];
            if(sourceRef) { 
                targetCanvas.width = sourceRef.width; 
                targetCanvas.height = sourceRef.height; 
                targetCanvas.getContext('2d').drawImage(sourceRef, 0, 0); 
            }

            const compCanvas = document.getElementById('comparison-confrontation-canvas');
            const sourceComp = masterCapturedCanvases[idx] || masterCapturedCanvases[6];
            if(sourceComp) { 
                compCanvas.width = sourceComp.width; 
                compCanvas.height = sourceComp.height; 
                compCanvas.getContext('2d').drawImage(sourceComp, 0, 0); 
            }
        }

        function selectArchetypeProfile(profile) {
            document.querySelectorAll('.elite-menu-btn').forEach(btn => btn.classList.remove('active-item'));
            if(profile === 'lideranca') { document.getElementById('btn-perf-lideranca').classList.add('active-item'); activeBiogenIndex = 6; renderSelectedConfrontation(activeBiogenIndex); }
            else if(profile === 'clinica') { document.getElementById('btn-perf-vitalidade').classList.add('active-item'); activeBiogenIndex = 7; renderSelectedConfrontation(activeBiogenIndex); }
            else if(profile === 'tricologia') { document.getElementById('btn-perf-poder').classList.add('active-item'); activeBiogenIndex = 8; renderSelectedConfrontation(activeBiogenIndex); }
        }

        const video = document.getElementById('webcam-feed-main');
        const overlayCanvas = document.getElementById('overlay-canvas-3d');
        const overlayCtx = overlayCanvas.getContext('2d');
        let beamY = 0;
        let beamDirection = 3;

        function renderMeshOverlay() {
            if (video.readyState === video.HAVE_ENOUGH_DATA) {
                overlayCanvas.width = video.videoWidth || 640; 
                overlayCanvas.height = video.videoHeight || 480;
                overlayCtx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);
                
                if (cameraActive) {
                    beamY += beamDirection;
                    if (beamY > overlayCanvas.height || beamY < 0) beamDirection *= -1;
                    overlayCtx.save();
                    let grad = overlayCtx.createLinearGradient(0, beamY - 30, 0, beamY + 30);
                    grad.addColorStop(0, 'rgba(59, 94, 102, 0)');
                    grad.addColorStop(0.5, 'rgba(255, 255, 255, 0.28)');
                    grad.addColorStop(1, 'rgba(59, 94, 102, 0)');
                    overlayCtx.fillStyle = grad;
                    overlayCtx.fillRect(0, beamY - 30, overlayCanvas.width, 60);
                    overlayCtx.restore();
                }
            }
            requestAnimationFrame(renderMeshOverlay);
        }

        const estadoGiroCanvas = {
            'selected-confrontation-canvas': { rodando: false, rotY: 0, rotX: 0, scale: 1.0, velocidade: 0.8, animId: null },
            'comparison-confrontation-canvas': { rodando: false, rotY: 0, rotX: 0, scale: 1.0, velocidade: 0.8, animId: null }
        };

        function toggleGiroCanvas(canvasId) {
            const estado = estadoGiroCanvas[canvasId];
            const canvas = document.getElementById(canvasId);
            if (!estado || !canvas) return;
            estado.rodando = !estado.rodando;
            if (estado.rodando) {
                function animarGiro() {
                    if (!estado.rodando) return;
                    estado.rotY += estado.velocidade;
                    canvas.style.transform = `perspective(800px) rotateY(${estado.rotY}deg) rotateX(${estado.rotX}deg) scale(${estado.scale})`;
                    canvas.style.transition = 'none';
                    estado.animId = requestAnimationFrame(animarGiro);
                }
                animarGiro();
            } else {
                cancelAnimationFrame(estado.animId);
            }
        }

        function alterarVelocidadeGiro(canvasId, delta) {
            const estado = estadoGiroCanvas[canvasId];
            if (!estado) return;
            estado.velocidade = Math.max(0.2, Math.min(4.0, estado.velocidade + delta));
        }

        function initInteractive3DConfrontationCards() {
            const canv1 = document.getElementById('selected-confrontation-canvas');
            const canv2 = document.getElementById('comparison-confrontation-canvas');
            [canv1, canv2].forEach(canvas => {
                if (!canvas) return;
                let rotX = 0, rotY = 0, scaleVal = 1.0, isDragging = false, startX = 0, startY = 0;
                canvas.style.cursor = 'grab';
                canvas.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    scaleVal = e.deltaY < 0 ? Math.min(scaleVal + 0.1, 2.0) : Math.max(scaleVal - 0.1, 0.8);
                    estadoGiroCanvas[canvas.id].scale = scaleVal;
                    atualizarTransformacao(canvas, rotX, rotY, scaleVal);
                }, { passive: false });
                canvas.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX; startY = e.clientY; canvas.style.cursor = 'grabbing'; });
                window.addEventListener('mouseup', () => { isDragging = false; canvas.style.cursor = 'grab'; });
                window.addEventListener('mousemove', (e) => {
                    if (!isDragging) return;
                    rotY += (e.clientX - startX) * 0.6;
                    rotX = Math.max(-50, Math.min(50, rotX - (e.clientY - startY) * 0.4));
                    const estado = estadoGiroCanvas[canvas.id];
                    estado.rotY = rotY; estado.rotX = rotX;
                    atualizarTransformacao(canvas, rotX, rotY, estado.scale);
                    startX = e.clientX; startY = e.clientY;
                });
            });
        }

        function atualizarTransformacao(targetCanvas, rx, ry, s) {
            targetCanvas.style.transform = `perspective(800px) rotateY(${ry}deg) rotateX(${rx}deg) scale(${s})`;
            targetCanvas.style.transition = 'none';
        }

        function captureBiogensFromWebcam() {
            if (!cameraActive || video.readyState < 2) return;
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = video.videoWidth || 640; tempCanvas.height = video.videoHeight || 480;
            const ctxTemp = tempCanvas.getContext('2d');
            ctxTemp.translate(tempCanvas.width, 0); ctxTemp.scale(-1, 1);
            ctxTemp.drawImage(video, 0, 0);
            
            masterCapturedCanvases = [];
            for(let i=1; i<=10; i++) {
                const c = document.createElement('canvas');
                c.width = 210; c.height = 140;
                c.getContext('2d').drawImage(tempCanvas, 0, 0, c.width, c.height);
                masterCapturedCanvases.push(c);
            }
        }

        function setupTickerCanvasItems() {
            const track = document.getElementById('tickerTrackContainer');
            track.innerHTML = '';
            for(let loop = 0; loop < 2; loop++) {
                for(let i = 0; i < masterCapturedCanvases.length; i++) {
                    const itemDiv = document.createElement('div'); itemDiv.className = 'ticker-item';
                    const c = document.createElement('canvas'); c.width = 75; c.height = 45;
                    c.getContext('2d').drawImage(masterCapturedCanvases[i], 0, 0, 75, 45);
                    itemDiv.appendChild(c); track.appendChild(itemDiv);
                }
            }
        }

        const cellData = [
            { id: 1, title: "01. FOTOTIPO", type: "safe", badge: "Aprovado", mesh: "MESH_64N_v1" },
            { id: 2, title: "02. CONTORNO", type: "safe", badge: "Normal", mesh: "MESH_64N_v2" },
            { id: 3, title: "03. COLÁGENO", type: "safe", badge: "Estável", mesh: "MESH_64N_VOL" },
            { id: 4, title: "04. +5 ANOS", type: "alert", badge: "Critico", mesh: "MESH_64N_AGE" },
            { id: 5, title: "05. +10 ANOS", type: "alert", badge: "Alerta", mesh: "MESH_64N_AGE" },
            { id: 6, title: "06. +15 ANOS", type: "alert", badge: "Zona Crítica", mesh: "MESH_64N_AGE" },
            { id: 7, title: "07. LIDERANÇA", type: "gold", badge: "Otimizado", mesh: "MESH_64N_OPT" },
            { id: 8, title: "08. VITALIDADE", type: "gold", badge: "Imperial", mesh: "MESH_64N_HIGH" },
            { id: 9, title: "09. SOBERANO", type: "gold", badge: "Máximo", mesh: "MESH_64N_FINAL" },
            { id: 10, title: "10. AUTÔNOMO", type: "safe", badge: "Estável", mesh: "MESH_64N_LIP" },
        ];

        function renderGrid() {
            const container = document.getElementById("biogen-grid-container");
            if (!container) return;
            container.innerHTML = cellData.map(cell => `
                <div class="grid-cell ${cell.type}" onclick="openBiogenFocusModal(${cell.id}, '${cell.title}'); playClinicalChimeSafe();" onmouseenter="playClinicalChimeSafe()">
                    <div class="cell-title">${cell.title}</div>
                    
                    <div class="cell-photo-placeholder">
                        <div class="status-badge">${cell.badge}</div>
                        <canvas id="biogen-cv-${cell.id}"></canvas>
                    </div>
                    
                    <div style="font-size: 8px; color: var(--text-secondary, #94a3b8); display:flex; justify-content:space-between; width:100%; font-family:monospace;">
                        <span>ID: 00${cell.id}_SYS</span>
                        <span>${cell.mesh}</span>
                    </div>
                </div>
            `).join('');
        }

        document.addEventListener("DOMContentLoaded", () => {
            renderGrid();
        });

        function startCinematicScan() {
            if (!consentimentoBiometricoAtivo || !cameraActive) { alert("⚠️ Ative o Apex Protocol e a câmera primeiro!"); return; }
            captureBiogensFromWebcam();
            setupTickerCanvasItems();

            scanCompletedFlag = false;
            const viewportMaster = document.getElementById('viewportCentralMasterBox');
            viewportMaster.classList.add('reading-active');
            const tickerEl = document.getElementById('biogens-flying-ticker');
            tickerEl.classList.add('active-ticker');
            
            setTimeout(() => {
                tickerEl.classList.remove('active-ticker');
                viewportMaster.classList.remove('reading-active');
                scanCompletedFlag = true;

                for(let i=1; i<=10; i++) {
                    const gridCanvas = document.getElementById(`biogen-cv-${i}`);
                    if(gridCanvas) {
                        gridCanvas.width = 210; gridCanvas.height = 140;
                        renderAdvancedBiogenTelemetry(gridCanvas, i - 1);
                    }
                }

                document.querySelectorAll('.telemetry-node-val').forEach(el => el.classList.add('magnetic-locked'));
                document.getElementById('telemetry-freq').innerText = "1.618 Hz";
                document.getElementById('telemetry-oxi').innerText = "99.9%";
                document.getElementById('telemetry-gov').innerText = "100% Tier-1";
                document.getElementById('telemetry-nodes-val').innerText = "64 Nós";

                const stripeBtn = document.getElementById('btn-open-stripe-modal');
                const reportBtn = document.getElementById('btn-open-pdf-modal');
                stripeBtn.classList.remove('locked-report'); stripeBtn.classList.add('unlocked-report');
                stripeBtn.innerText = "Ativar Licença Executiva 💳";
                reportBtn.classList.remove('locked-report'); reportBtn.classList.add('unlocked-report');
                reportBtn.innerText = "Gerar Relatórios PDF";

                switchStage(2);
            }, 7000);
        }
    </script>
</body>
</html>