            <button onclick="closeStripeModal()" style="background: none; border: 1px solid var(--border-sovereign); color: var(--text-primary); padding: 5px 9px; border-radius: 6px; cursor: pointer; font-size: 11px;">✕</button>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px; padding: 10px 0; font-family: monospace; font-size: 11px;">
            <div style="background: rgba(5,150,105,0.06); border: 1px solid rgba(5,150,105,0.3); border-radius: 8px; padding: 10px; color: var(--text-primary);">
                <strong>LICENCIAMENTO TIER-1 MÔNACO</strong><br>
                <span style="font-size: 9.5px; color: var(--text-secondary);">Ativação institucional global e enclaves UHNW encriptados.</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 4px;">
                <label style="font-size: 9.5px; font-weight: bold; text-transform: uppercase; color: var(--text-secondary);">Titular da Licença:</label>
                <input type="text" id="stripe-holder-name" value="THIÉBRY RODRIGUES" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-sovereign); border-radius: 6px; padding: 8px; color: var(--text-primary); font-size: 11px; outline: none;" readonly>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; background: rgba(59, 94, 102, 0.05); border: 1px solid var(--border-sovereign); border-radius: 8px; padding: 12px;">
                <span style="font-size: 9.5px; font-weight: bold; text-transform: uppercase; color: var(--accent-clinical);">Informações do Cartão de Crédito / Stripe Elements:</span>
                
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <label style="font-size: 8.5px; color: var(--text-secondary);">Número do Cartão</label>
                    <input type="text" placeholder="4242 •••• •••• 4242" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-sovereign); border-radius: 6px; padding: 7px; color: var(--text-primary); font-size: 11px; outline: none;" maxlength="19">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 8.5px; color: var(--text-secondary);">Validade (MM/AA)</label>
                        <input type="text" placeholder="MM/AA" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-sovereign); border-radius: 6px; padding: 7px; color: var(--text-primary); font-size: 11px; outline: none;" maxlength="5">
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 8.5px; color: var(--text-secondary);">CVC / CVV</label>
                        <input type="password" placeholder="123" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-sovereign); border-radius: 6px; padding: 7px; color: var(--text-primary); font-size: 11px; outline: none;" maxlength="4">
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 9px; color: var(--text-secondary);">Investimento Anual:</span>
                <span style="font-size: 13px; font-weight: bold; color: var(--green-secure);">$ 12,500.00 USD</span>
            </div>

            <!-- BOTÃO DE ASSINAR / AUTORIZAR PAGAMENTO (AZUL STRIPE) -->
            <button onclick="processarPagamentoStripeReal()" class="btn-proceed-flow" style="width: 100%; padding: 12px; background: #0085FF; border: none; color: #fff; font-weight: bold; font-size: 12px; text-transform: uppercase; border-radius: 6px; cursor: pointer; text-align: center; box-shadow: 0 4px 12px rgba(0,133,255,0.3); margin-top: 4px;">
                Assinar / Autorizar Pagamento ✓
            </button>

            <!-- BOTÃO DE RETORNO DIRETO LOGO ABAIXO DA ASSINATURA -->
            <div style="display: flex; justify-content: center; margin-top: 4px;">
                <button onclick="closeStripeModal()" class="lang-btn" style="background: rgba(255,255,255,0.03); border: 1px dashed var(--border-sovereign); color: var(--text-secondary); padding: 9px 16px; border-radius: 6px; font-size: 10px; text-transform: uppercase; cursor: pointer; width: 100%; transition: all 0.2s;">
                    ← Voltar ao Terminal Principal
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let idiomaAtualUHNW = 'PT';
    let globalUhnwMedicalLogs = [];

    const traducoesUHNW = {
        PT: {
            title: "Prontuário & Histórico de Evolução UHNW",
            subtitle: "[Padrão Global Tier-1 | HIPAA & GDPR Medical Encrypted]",
            patient: "PACIENTE:",
            doctor: "MÉDICO RESPONSÁVEL / CRM:",
            segment: "SEGMENTO:",
            mesh: "STATUS DA MALHA:",
            history: "Histórico Consolidado & Varreduras Anteriores:",
            newNote: "Nova Evolução / Anotação Clínica & Prescrição:",
            placeholderNote: "Digite ou dite aqui a nova evolução clínica, diretriz de visagismo ou prescrição de ativos...",
            placeholderDoctor: "Digite o Nome do Médico e CRM...",
            back: "Voltar ao Sistema",
            voice: "Ativar Comando de Voz",
            pdf: "Gerar Relatório PDF",
            save: "Salvar Evolução ✓",
            alertEmpty: "Por favor, insira alguma anotação na evolução clínica antes de salvar.",
            alertDoctorEmpty: "Por favor, informe o Nome e CRM do Médico responsável antes de salvar a evolução.",
            alertSaved: "Evolução clínica UHNW salva, assinada e criptografada com sucesso no prontuário!",
            alertVoice: "🎙️ Comando de Voz Clínico integrado com sucesso na evolução do paciente!",
            alertPdf: "📄 Compilando Relatório de Auditoria PDF criptografado para: ",
            alertSecurity: "🔒 SINAL VERDE DE SEGURANÇA MÔNACO:\n\nCanal criptografado de ponta a ponta (AES-256-GCM / SHA-512).\nConformidade total com os padrões internacionais HIPAA e GDPR.\nIntegridade de dados ativa com 64 nós sincronizados.",
            emptyLog: "Nenhum histórico anterior registrado. O prontuário está limpo e pronto para novas evoluções."
        },
        EN: {
            title: "UHNW Electronic Health Record & Evolution",
            subtitle: "[Monaco Tier-1 Standard | HIPAA & GDPR Medical Encrypted]",
            patient: "PATIENT:",
            doctor: "ATTENDING PHYSICIAN / CRM:",
            segment: "SEGMENT:",
            mesh: "MESH STATUS:",
            history: "Consolidated History & Previous Scans:",
            newNote: "New Evolution / Clinical Note & Prescription:",
            placeholderNote: "Type or dictate here the new clinical evolution, visagism guideline, or asset prescription...",
            placeholderDoctor: "Type Physician Name & CRM...",
            back: "Back to System",
            voice: "Activate Voice Command",
            pdf: "Generate PDF Report",
            save: "Save Evolution ✓",
            alertEmpty: "Please enter some notes in the clinical evolution before saving.",
            alertDoctorEmpty: "Please provide the Attending Physician Name and CRM before saving.",
            alertSaved: "UHNW clinical evolution successfully saved, signed, and encrypted in the record!",
            alertVoice: "🎙️ Clinical Voice Command successfully integrated into patient evolution!",
            alertPdf: "📄 Compiling encrypted PDF Audit Report for: ",
            alertSecurity: "🔒 MONACO SECURITY GREEN LIGHT:\n\nEnd-to-end encrypted channel (AES-256-GCM / SHA-512).\nFull compliance with HIPAA and GDPR international standards.\nActive data integrity with 64 synchronized nodes.",
            emptyLog: "No previous history recorded. The record is clean and ready for new evolutions."
        }
    };

    function renderizarHistoricoUHNW() {
        const container = document.getElementById('uhnw-historical-logs-container');
        if (!container) return;

        if (globalUhnwMedicalLogs.length === 0) {
            container.innerHTML = `<span style="color: #64748b; font-style: italic;">${traducoesUHNW[idiomaAtualUHNW].emptyLog}</span>`;
            return;
        }

        let html = "";
        globalUhnwMedicalLogs.forEach((log) => {
            let labelMedico = (idiomaAtualUHNW === 'EN') ? "Attending Physician" : "Médico Responsável";
            html += `• [${log.data}] <strong>${labelMedico} (${log.medico}):</strong> ${log.nota}<br>`;
        });
        container.innerHTML = html;
    }

    function exibirStatusSegurancaUHNW() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const t = traducoesUHNW[idiomaAtualUHNW];
        alert(t.alertSecurity);
    }

    function mudarIdiomaModalUHNW(lang) {
        idiomaAtualUHNW = lang;
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        
        document.getElementById('uhnw-lang-pt').classList.toggle('active-lang', lang === 'PT');
        document.getElementById('uhnw-lang-en').classList.toggle('active-lang', lang === 'EN');

        const t = traducoesUHNW[lang];
        document.getElementById('uhnw-txt-title').textContent = t.title;
        document.getElementById('uhnw-txt-subtitle').textContent = t.subtitle;
        document.getElementById('uhnw-lbl-patient').textContent = t.patient;
        document.getElementById('uhnw-lbl-doctor').textContent = t.doctor;
        document.getElementById('uhnw-lbl-segment').textContent = t.segment;
        document.getElementById('uhnw-lbl-mesh').textContent = t.mesh;
        document.getElementById('uhnw-lbl-history').textContent = t.history;
        document.getElementById('uhnw-lbl-new-note').textContent = t.newNote;
        document.getElementById('uhnw-new-clinical-note').placeholder = t.placeholderNote;
        document.getElementById('uhnw-doctor-input').placeholder = t.placeholderDoctor;
        document.getElementById('uhnw-btn-back-text').textContent = t.back;
        document.getElementById('uhnw-btn-voice-text').textContent = t.voice;
        document.getElementById('uhnw-btn-pdf-text').textContent = t.pdf;
        document.getElementById('uhnw-btn-save').textContent = t.save;
        renderizarHistoricoUHNW();
    }

    function alternarExpansaoModalUHNW() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const drawer = document.getElementById('uhnw-drawer-box');
        const btnExpand = document.getElementById('uhnw-btn-expand');
        if (drawer) {
            drawer.classList.toggle('maximized');
            const isMax = drawer.classList.contains('maximized');
            btnExpand.textContent = isMax ? "🗗" : "🗖";
        }
    }

    function abrirModalHistoricoUHNW() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const modal = document.getElementById('modal-historico-uhnw');
        if (modal) {
            modal.classList.add('active');
            const clientNameInput = document.getElementById('client-name-input');
            const displayEl = document.getElementById('uhnw-client-display');
            if (displayEl) {
                displayEl.textContent = (clientNameInput && clientNameInput.value) ? clientNameInput.value : "THIÉBRY RODRIGUES";
            }
            renderizarHistoricoUHNW();
        }
    }

    function fecharModalHistoricoUHNW() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const modal = document.getElementById('modal-historico-uhnw');
        if (modal) modal.classList.remove('active');
    }

    function integrarVozNoHistorico() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const textarea = document.getElementById('uhnw-new-clinical-note');
        const t = traducoesUHNW[idiomaAtualUHNW];
        if (textarea) {
            let msgVoz = (idiomaAtualUHNW === 'EN') ? "[🎙️ Voice Transcribed]: Monaco anchor protocol & bioregulation applied successfully." : "[🎙️ Voz Transcrita]: Protocolo de ancoragem e biorregulação Mônaco aplicado com sucesso.";
            textarea.value += (textarea.value ? "\n" : "") + msgVoz;
        }
        alert(t.alertVoice);
    }

    function gerarPdfComHistorico() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const clientName = document.getElementById('client-name-input') ? document.getElementById('client-name-input').value : "THIÉBRY RODRIGUES";
        const t = traducoesUHNW[idiomaAtualUHNW];
        fecharModalHistoricoUHNW();
        if (typeof openPdfModal === 'function') {
            openPdfModal();
        } else {
            alert(t.alertPdf + clientName + " (HIPAA & GDPR Compliant).");
        }
    }

    function salvarEvolucaoHistoricoUHNW() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const nota = document.getElementById('uhnw-new-clinical-note').value.trim();
        const medico = document.getElementById('uhnw-doctor-input').value.trim();
        const t = traducoesUHNW[idiomaAtualUHNW];

        if (!medico) {
            alert(t.alertDoctorEmpty);
            document.getElementById('uhnw-doctor-input').focus();
            return;
        }

        if (!nota) {
            alert(t.alertEmpty);
            document.getElementById('uhnw-new-clinical-note').focus();
            return;
        }

        const agora = new Date();
        const dataFormatada = String(agora.getDate()).padStart(2, '0') + '/' + 
                              String(agora.getMonth() + 1).padStart(2, '0') + '/' + 
                              agora.getFullYear();

        globalUhnwMedicalLogs.push({
            data: dataFormatada,
            medico: medico,
            nota: nota
        });

        alert(t.alertSaved);
        document.getElementById('uhnw-new-clinical-note').value = '';
        renderizarHistoricoUHNW();
        fecharModalHistoricoUHNW();
    }

    // Funções de Controle Stripe
    function openStripeModal() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const modal = document.getElementById('stripe-checkout-modal');
        if (modal) modal.classList.add('active');
    }

    function closeStripeModal() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        const modal = document.getElementById('stripe-checkout-modal');
        if (modal) modal.classList.remove('active');
    }

    function processarPagamentoStripeReal() {
        if (typeof playLuxuryAcousticChime === 'function') playLuxuryAcousticChime();
        alert("💳 Pagamento processado com sucesso via Stripe Secure API!\nLicença Tier-1 Mônaco ativada e enclaves liberados.");
        closeStripeModal();
    }
