<!-- BLOCO DE PONTE JS COM O GERENCIADOR CENTRAL MIBO -->
<script>
    let currentModuleId = null;
    let currentPdfLang = 'PT';

    function setPdfLanguage(lang) {
        currentPdfLang = lang;
        document.getElementById('btn-pdf-pt').classList.toggle('active-lang', lang === 'PT');
        document.getElementById('btn-pdf-en').classList.toggle('active-lang', lang === 'EN');
    }

    // Função que despacha o ID isolado para a rota central do backend (GerenciadorCentralMibo)
    async function dispararGerenciadorMibo(moduleId, acao = 'download') {
        currentModuleId = moduleId;
        const emailTarget = document.getElementById('dispatch-email-target').value;

        console.log(`[Mibo Frontend] Despachando módulo: ${moduleId} | Ação: ${acao} | Idioma: ${currentPdfLang}`);

        try {
            const response = await fetch('/api/v1/processar-gerenciador-mibo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    module_id: moduleId,
                    action: acao,
                    language: currentPdfLang,
                    email: emailTarget
                })
            });

            if (!response.ok) {
                throw new Error(`Erro no servidor: ${response.statusText}`);
            }

            const data = await response.json();
            console.log("[Mibo Backend Response]:", data);
            return data;
        } catch (error) {
            console.error("[Mibo Erro de Despacho]:", error);
            alert("Erro ao comunicar com o Gerenciador Central Mibo. Verifique o terminal.");
            return null;
        }
    }

    // 👁️ Botão Ver: Carrega o PDF gerado de forma isolada dentro do visualizador embutido
    async function visualizarDossiêEmbutido(moduleId) {
        const result = await dispararGerenciadorMibo(moduleId, 'view');
        if (result && result.pdf_url) {
            const container = document.getElementById('embedded-viewer-container');
            const frame = document.getElementById('pdf-embedded-frame');
            const title = document.getElementById('embedded-viewer-title');
            
            title.textContent = `VISUALIZADOR SOBERANO • MÓDULO: ${moduleId.toUpperCase()}`;
            frame.src = result.pdf_url;
            container.style.display = 'flex';
            container.scrollIntoView({ behavior: 'smooth' });
        }
    }

    // ⤢ Botão Expandir: Abre o relatório isolado em tela cheia
    async function expandirDossiêTelaCheia(moduleId) {
        const result = await dispararGerenciadorMibo(moduleId, 'fullscreen');
        if (result && result.pdf_url) {
            const modal = document.getElementById('pdf-fullscreen-viewer');
            const frame = document.getElementById('pdf-fullscreen-frame');
            const title = document.getElementById('fullscreen-pdf-title');

            title.textContent = `TCC GLOBAL • RELATÓRIO ISOLADO: ${moduleId.toUpperCase()}`;
            frame.src = result.pdf_url;
            modal.style.display = 'flex';
        }
    }

    // 📥 Botão Baixar: Dispara o motor matemático, imprime o parecer no terminal e efetua o download direto do PDF exclusivo
    async function gerarEExibirRelatorioPDF(moduleId) {
        const result = await dispararGerenciadorMibo(moduleId, 'download');
        if (result && result.download_url) {
            const link = document.createElement('a');
            link.href = result.download_url;
            link.download = `Relatorio_${moduleId}_TCC_Global.pdf`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else if (result && result.message) {
            alert(result.message);
        }
    }

    function fecharVisualizadorEmbutido() {
        document.getElementById('embedded-viewer-container').style.display = 'none';
        document.getElementById('pdf-embedded-frame').src = '';
    }

    function expandirAtualDoEmbutido() {
        if (currentModuleId) {
            expandirDossiêTelaCheia(currentModuleId);
        }
    }

    function fecharFullscreenPDF() {
        document.getElementById('pdf-fullscreen-viewer').style.display = 'none';
        document.getElementById('pdf-fullscreen-frame').src = '';
    }

    async function enviarDocumentoPorEmail() {
        if (!currentModuleId) return;
        const emailTarget = document.getElementById('dispatch-email-target').value;
        const result = await dispararGerenciadorMibo(currentModuleId, 'email');
        if (result) {
            alert(`Relatório enviado com sucesso para: ${emailTarget}`);
        }
    }

    function closePdfModal() {
        const modal = document.getElementById('pdf-report-modal');
        if (modal) modal.style.display = 'none';
    }

    function closeBiogenDetailModal() {
        const modal = document.getElementById('biogen-detail-modal');
        if (modal) modal.style.display = 'none';
    }
</script><script>
