        }
        .modal-header-elite { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-sovereign); padding-bottom: 10px; font-size: 11px; color: var(--accent-clinical); font-weight: 700; text-transform: uppercase; }
        .modal-close-btn { background: var(--btn-glass-bg); border: 1px solid var(--border-sovereign); color: var(--text-secondary); width: 28px; height: 28px; border-radius: 50%; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
        .modal-close-btn:hover { color: var(--accent-clinical); border-color: var(--accent-clinical); box-shadow: var(--backlit-hover-glow); }
        
        /* EFEITO LED / GLOW SUTIL PARA O BOTÃO PRINCIPAL DE SCAN */
        .btn-apex-primary-scan {
            background: var(--btn-glass-bg);
            border: 1px solid var(--accent-clinical);
            color: var(--text-primary);
            position: relative;
            transition: all 0.3s ease;
            box-shadow: 0 0 8px rgba(2, 132, 199, 0.25);
        }
        .btn-apex-primary-scan:hover {
            background: rgba(2, 132, 199, 0.12);
            box-shadow: 0 0 15px rgba(2, 132, 199, 0.5);
            border-color: var(--accent-clinical);
        }
        .text-led-pulse {
            animation: ledGlowPulse 2.5s infinite ease-in-out;
            color: var(--accent-clinical);
            font-weight: bold;
        }
        @keyframes ledGlowPulse {
            0% { text-shadow: 0 0 4px rgba(2,132,199,0.4); opacity: 0.85; }
            50% { text-shadow: 0 0 12px rgba(2,132,199,0.85), 0 0 20px rgba(5,150,105,0.3); opacity: 1; }
            100% { text-shadow: 0 0 4px rgba(2,132,199,0.4); opacity: 0.85; }
        }

        /* BOTÕES SECUNDÁRIOS DISCRETOS (STRIPE / RELATÓRIOS) COM HOVER ELEGANTE */
        .btn-apex-subtle {
            background: var(--btn-glass-bg);
            border: 1px solid var(--border-sovereign);
            color: var(--text-secondary);
            transition: all 0.25s ease;
        }
        .btn-apex-subtle:hover {
            background: var(--btn-glass-hover, rgba(255, 255, 255, 0.05));
            border-color: var(--accent-clinical);
            color: var(--text-primary);
            box-shadow: var(--backlit-hover-glow, 0 0 10px rgba(2, 132, 199, 0.15));
        }

        .pdf-fullscreen-modal {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(15px);
            z-index: 10000; display: none; flex-direction: column; padding: 20px;
        }
        .pdf-fullscreen-modal.active-modal { display: flex; }
    </style>
