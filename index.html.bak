        }
        .uhnw-modal-overlay.active { display: flex; }
        .uhnw-modal-drawer {
            background: var(--panel-yacht-dark, #0E131F); border: 1px solid var(--border-sovereign); border-radius: 18px;
            width: 820px; max-width: 95vw; max-height: 92vh; padding: 24px; display: flex; flex-direction: column; gap: 14px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.9), var(--backlit-clinical-glow); color: var(--text-primary);
