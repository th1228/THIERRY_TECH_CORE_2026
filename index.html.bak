            <textarea id="uhnw-new-clinical-note" placeholder="Digite ou dite aqui a nova evolução clínica, diretriz de visagismo ou prescrição de ativos..." style="width: 100%; flex: 1; min-height: 110px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-sovereign); border-radius: 8px; padding: 12px; color: var(--text-primary); font-size: 12px; font-family: sans-serif; resize: none; outline: none; line-height: 1.5;"></textarea>
