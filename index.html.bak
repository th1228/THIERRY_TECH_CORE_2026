            background: rgba(59, 94, 102, 0.1);
            color: var(--text-primary);
            box-shadow: var(--backlit-hover-glow);
            transform: translateY(-2px);
        }
        .luxury-sidebar .btn-master-trigger.locked-report { 
            opacity: 0.45; filter: grayscale(80%); cursor: not-allowed; pointer-events: none; box-shadow: none; 
        }
        .luxury-sidebar .btn-master-trigger.unlocked-report { 
