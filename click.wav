import cv2
import mediapipe as mp
import time
import os

def main():
    cap = cv2.VideoCapture(0)
    # Configuração do Scan
    scan_y_pos = -0.1
    velocidade = 0.02
    cor_neon = (127, 255, 0)
    
    # Caminho absoluto para evitar erro de leitura
    caminho_som = os.path.abspath("click.wav")

    while cap.isOpened():
        success, frame = cap.read()
        if not success: break

        frame = cv2.flip(frame, 1)
        h, w, _ = frame.shape
        display_frame = frame.copy()

        # 1. LÓGICA DOS 5 DISPAROS (Sincronizado com a linha)
        scan_y_pos += velocidade
        
        if scan_y_pos >= 0.95 and scan_y_pos < 0.95 + velocidade:
            # Comando direto do Windows para tocar o som 5 vezes rápido e limpo
            for _ in range(5):
                # O 'start /min' faz o som tocar sem abrir janela e sem travar o vídeo
                os.system(f'start /min powershell -c "(New-Object Media.SoundPlayer \'{caminho_som}\').PlaySync()"')
                time.sleep(0.05) 

        if scan_y_pos > 1.2: scan_y_pos = -0.1

        # 2. DESENHO DA LINHA
        y_line = int(scan_y_pos * h)
        if 0 <= y_line < h:
            cv2.line(display_frame, (0, y_line), (w, y_line), cor_neon, 2)

        # 3. SUGESTÃO DE CORTE (VISAGISMO LUXO)
        # Posicionado exatamente onde você precisa
        cv2.putText(display_frame, "CORTE SUGERIDO: MEDIUM SIDE SWEEP", (30, 150), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, cor_neon, 2)
        cv2.putText(display_frame, "ESTILO: TEXTURIZADO LUXO - MONACO PLATINUM", (30, 180), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, cor_neon, 1)

        cv2.imshow("THIERRY TECHNOLOGY - TTC CORE", display_frame)
        if cv2.waitKey(1) & 0xFF == ord('q'): break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()